  "run_kind": "smoke",
  "model": "PaddleOCR-VL-1.6-GGUF",
  "adapter": "paddleocr-vl-1.6",
  "engine": "lightweight",
  "variant": "cpu",
  "expected_pages": 10,
  "max_pages": 10,
  "prediction_dir": "predictions/paddleocrvl_cpu_smoke_10",
